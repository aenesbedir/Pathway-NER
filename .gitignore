# Phase 2 generated data & logs (regenerable from scripts)
data/processed/bio_tags_v2.jsonl
data/processed/phase2/

# Generated diagnostics and logs
analysis/alignment_*.json
logs/*.log
runs/*.log
data/silver/*.log

# doccano batch archives (regenerable via doccano/split_batches.py)
doccano/batches.zip

# Wave-2 review-to-gold pipeline: all derived outputs are regenerable from the
# tracked silver and review files via data/processed/gold/README.md.
doccano/wave2_1k_doccano.jsonl
doccano/wave2_1k_gold.jsonl
doccano/pilot_1k_batch0[1-3]_gold.jsonl
doccano/pilot_1k_batch05_gold.jsonl
doccano/batches/wave2_1k_doccano_batch_*_5.jsonl

# Wave-3/4 review JSONs remain local audit material. Their final human-reviewed
# gold JSONL files are tracked as the canonical annotation records; doccano
# imports and batch slices remain regenerable intermediates.
analysis/wave3_batch*_review.json
analysis/wave4_batch*_review.json
doccano/wave3_1k_doccano.jsonl
doccano/wave4_1k_doccano.jsonl
doccano/batches/wave3_1k_doccano_batch_*_5.jsonl
doccano/batches/wave4_1k_doccano_batch_*_5.jsonl

data/processed/gold/*.jsonl

# Per-tokenizer datasets: regenerable from data/processed/gold/{matches,articles}
# .jsonl + splits.json via preprocessing/tag_bio.py --model X. splits.json itself
# is tracked — it is the contract that makes two encoders comparable.
data/processed/gold-*/

# gold-wave4 is a model-independent, versioned corpus root. Keep its README and
# frozen split; matches/articles and all gold-wave4-<tokenizer>/ directories are
# regenerable and remain ignored by the rule above.
!data/processed/gold-wave4/
data/processed/gold-wave4/*.jsonl

# Full reviewed pilot expansion. Keep its provenance and frozen split; the
# model-independent JSONLs are regenerated from the canonical doccano gold files.
!data/processed/gold-pilot1k/
data/processed/gold-pilot1k/*.jsonl

# Mixed-curation 10k pathway experiment. The frozen split is tracked; the
# model-independent JSONLs and tokenizer-specific datasets are transferred to
# TRUBA separately because they are generated from the local Doccano export.
data/processed/pathway-10k/*.jsonl
data/processed/pathway-10k-*/
# The merged 10k + missing-pathway corpus follows the same rule as pathway-10k:
# its frozen split is the contract between runs, so it is tracked while the
# generated corpus and tokenizer-specific datasets are not.
!data/processed/pathway-10k-missing/
data/processed/pathway-10k-missing/*
!data/processed/pathway-10k-missing/splits.json

# Sweep outputs. summary.jsonl is the aggregated result and is kept; the
# per-run directories hold logs and prediction dumps and are regenerable.
runs/*/
!runs/summary.jsonl
runs-truba*/

# remaining_6125 disease/pathway review batch. Only the PMID list that defines
# the corpus slice and the review summary are tracked; every other artefact in
# the chain below is a machine output kept locally.
#
#   pmids.txt -> articles -> BENT spans      -> disease doccano  \
#                         -> qwen2.5:14b     -> pathway doccano  |-> merged doccano
#                                                                /
#   merged doccano + PubTator cache + pathway checkpoint -> reviews/
#
# Caveat recorded deliberately: the qwen2.5:14b silver is LLM sampling output
# and is not bit-reproducible from the tracked inputs. Losing it means the
# PATHWAY side of this batch cannot be rebuilt exactly. Keep local backups.
data/doccano/
data/evaluation/
data/processed/disease-ner/
data/processed/pathway-ner/
data/silver/pathway_remaining_6125.jsonl

# Review candidates are a pure derivative of the sources above; the summary is
# the provenance record and stays tracked.
data/reviews/*
!data/reviews/*.summary.json

# KEGG–Recon3D corpus: fetched abstracts. Regenerates from the tracked CSV via
# pubmed_api/fetch_kegg_abstracts.py (shared article_cache makes a re-fetch cheap).
# The CSV, the derived query_pathways.jsonl and pmids.txt stay tracked — they are
# the inputs that define the corpus.
data/raw/kegg_recon3d/articles.json
data/raw/kegg_recon3d/fulltext_50/
# Shared with the main checkout rather than re-fetched per worktree.
data/raw/llm_cache_silver

# Missing-pathway recovery run (scripts/fetch_missing_pathways.py and friends):
# a PubMed search cache, the fetched abstracts and the NER output all regenerate
# from unique_pathways_from_recon.json + preprocessing/pathway_surface_forms.py.
# Only the report under reports/ is tracked.
data/raw/missing_pathways/
data/processed/missing_pathways/
